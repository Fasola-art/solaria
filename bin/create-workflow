#!/usr/bin/env python3
import argparse
import json
import re
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
AGENTS = HOME / ".agents"
WORKFLOWS_JSON = AGENTS / "ontology" / "workflows.json"
ACTIVATIONS_LOG = AGENTS / "runtime" / "session-activations.jsonl"
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,62}$")
RESEARCH_REQUIRED = "Research brief is required. Use the research skill first, then pass --research-brief <path-or-json>. For tests or migrations, pass --skip-research-brief <reason>."


def now():
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def load_research_brief(value):
    if not value:
        return None
    path = Path(value).expanduser()
    if path.exists():
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            raise SystemExit(f"Invalid research brief JSON: {path}: {exc}") from exc
        return {"path": str(path), "data": data}
    try:
        data = json.loads(value)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Research brief must be a readable JSON file or inline JSON: {exc}") from exc
    return {"path": None, "data": data}


def require_research_brief(args):
    if args.research_brief and args.skip_research_brief:
        raise SystemExit("Use either --research-brief or --skip-research-brief, not both.")
    if not args.research_brief and not args.skip_research_brief:
        raise SystemExit(RESEARCH_REQUIRED)
    if args.skip_research_brief is not None and not args.skip_research_brief.strip():
        raise SystemExit("--skip-research-brief requires a non-empty reason.")
    if args.skip_research_brief:
        return {"skipped": True, "reason": args.skip_research_brief.strip()}
    brief = load_research_brief(args.research_brief)
    data = brief["data"]
    if not isinstance(data, dict):
        raise SystemExit("Research brief JSON must be an object.")
    missing = [key for key in ["intent", "candidate_type", "target_id", "decision"] if not data.get(key)]
    if missing:
        raise SystemExit(f"Research brief missing required fields: {', '.join(missing)}")
    if data.get("candidate_type") != "workflow":
        raise SystemExit("create-workflow requires a research brief with candidate_type: workflow.")
    return {"skipped": False, "path": brief["path"], "data": data}


def parse_steps(values):
    steps = []
    for value in values:
        if ":" not in value:
            raise SystemExit(f"Step must be persona:skill: {value}")
        persona, skill = [part.strip() for part in value.split(":", 1)]
        if not persona or not skill:
            raise SystemExit(f"Step must be persona:skill: {value}")
        steps.append({"persona": persona, "skill": skill})
    if not steps:
        raise SystemExit("At least one --step persona:skill is required.")
    return steps


def load_workflows():
    if not WORKFLOWS_JSON.exists():
        return {"schema_version": 1, "generated_at": now(), "workflows": {}}
    try:
        return json.loads(WORKFLOWS_JSON.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Invalid workflows JSON: {WORKFLOWS_JSON}: {exc}") from exc


def activation_packet(workflow_id, steps, research):
    return {
        "ts": now(),
        "event": "session_activation",
        "activated_type": "workflow",
        "id": workflow_id,
        "path": str(WORKFLOWS_JSON),
        "steps": steps,
        "status": "created",
        "source": "create-workflow",
        "reason": "created",
        "research": research,
        "prompt_hash": None,
        "current_session_instruction": "Load each step's skill and persona directly in order for the current session. Do not wait for native runtime workflow or skill auto-trigger refresh.",
    }


def log_packet(packet):
    ACTIVATIONS_LOG.parent.mkdir(parents=True, exist_ok=True)
    with ACTIVATIONS_LOG.open("a", encoding="utf-8") as f:
        f.write(json.dumps(packet, ensure_ascii=False) + "\n")


def print_activation(packet, mode):
    if mode == "none":
        print(packet["path"])
        return
    if mode == "json":
        print(json.dumps(packet, indent=2, ensure_ascii=False))
        return
    print(f"created: {packet['path']}#{packet['id']}")
    print("current-session activation:")
    print(f"- workflow: {packet['id']}")
    print(f"- instruction: {packet['current_session_instruction']}")


def main():
    parser = argparse.ArgumentParser(description="Create a shared workflow ontology entry.")
    parser.add_argument("id", help="Lowercase hyphen-case workflow id.")
    parser.add_argument("--step", action="append", default=[], help="Workflow step as persona:skill. Repeat in execution order.")
    parser.add_argument("--description", default="", help="Optional workflow description.")
    parser.add_argument("--research-brief", default=None, help="Path to creation research brief JSON, or inline JSON. Required unless --skip-research-brief is used.")
    parser.add_argument("--skip-research-brief", default=None, help="Explicit reason for bypassing research-first creation. Intended for tests and migrations.")
    parser.add_argument("--activation", choices=["text", "json", "none"], default="text", help="Print current-session activation packet.")
    parser.add_argument("--no-activation-log", action="store_true", help="Do not append to session-activations.jsonl.")
    args = parser.parse_args()

    workflow_id = args.id.strip()
    if not NAME_RE.match(workflow_id):
        raise SystemExit("Workflow id must be lowercase hyphen-case, max 63 characters.")
    research = require_research_brief(args)
    steps = parse_steps(args.step)

    WORKFLOWS_JSON.parent.mkdir(parents=True, exist_ok=True)
    data = load_workflows()
    workflows = data.setdefault("workflows", {})
    if workflow_id in workflows:
        raise SystemExit(f"Workflow already exists: {workflow_id}")
    workflows[workflow_id] = {
        "id": workflow_id,
        "type": "Workflow",
        "description": args.description,
        "steps": steps,
    }
    if research.get("skipped"):
        workflows[workflow_id]["creation_research_skipped"] = research["reason"]
    else:
        workflows[workflow_id]["creation_research_brief"] = research.get("path")
        workflows[workflow_id]["creation_decision"] = research.get("data", {}).get("decision")
    data["generated_at"] = now()
    WORKFLOWS_JSON.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")

    packet = activation_packet(workflow_id, steps, research)
    if not args.no_activation_log:
        log_packet(packet)
    print_activation(packet, args.activation)


if __name__ == "__main__":
    main()
